# Shared secrets/config for `docker-compose up -d`. Copy to `.env` and adjust before
# running - docker-compose reads `.env` in this directory automatically.

# --- JWT (must be identical across every service - auth-service signs, everyone verifies) ---
JWT_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Seeded admin account (auth-service creates it on first boot if missing) ---
ADMIN_EMAIL=admin@shiptrack.local
ADMIN_PASSWORD=Admin@12345

# --- PostgreSQL ---
POSTGRES_USER=shiptrack
POSTGRES_PASSWORD=shiptrack
POSTGRES_HOST_PORT=15432

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=shiptrack
MYSQL_PASSWORD=shiptrack
MYSQL_HOST_PORT=13306

# --- MongoDB ---
MONGO_HOST_PORT=27019

# --- Notification service SMTP (leave blank to use the JSON/log transport) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ShipTrack <no-reply@shiptrack.local>

# --- API Gateway host port (change if this is taken on your machine) ---
GATEWAY_HOST_PORT=18000

# --- Frontend host port ---
FRONTEND_HOST_PORT=3001

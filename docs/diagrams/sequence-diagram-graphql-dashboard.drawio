        </mxCell>
        <mxCell id="m6_retry" value="Case 2 (Transient 5xx Error): Axios Exponential Retry (Attempt 2) -> 200 OK" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">

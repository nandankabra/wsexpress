        <mxCell id="ll_shipment" value="Shipment Service (:8004)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="980" y="40" width="150" height="900" as="geometry" />
        </mxCell>
        <mxCell id="ll_tracking" value="Tracking Service (:8005)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1220" y="40" width="150" height="900" as="geometry" />
        </mxCell>

        <!-- Message 1 -->
        <mxCell id="m1" value="1. POST /graphql (Query: myDashboard { profile, recentShipments })" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="120" as="sourcePoint" />
            <mxPoint x="350" y="120" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2. Forward GraphQL Query (X-Correlation-Id)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="160" as="sourcePoint" />
            <mxPoint x="575" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Par Frame: Parallel Data Fetch -->
        <mxCell id="par_fetch" value="par [Parallel Microservice Data Fetching via Promise.all()]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=310;height=30;fillColor=none;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="200" width="530" height="170" as="geometry" />
        </mxCell>

        <mxCell id="m3_user" value="3. GET /api/v1/users/me" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;" edge="1" parent="1">

          </mxGeometry>
        </mxCell>
        <mxCell id="m4_shipment" value="4. GET /api/v1/shipments?limit=5" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="575" y="310" as="sourcePoint" />
            <mxPoint x="1055" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Loop Frame: Iterate Active Shipments -->
        <mxCell id="loop_shipments" value="loop [For Each Active Shipment in recentShipments List]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=300;height=30;fillColor=none;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="400" width="770" height="320" as="geometry" />
        </mxCell>

        <!-- Alt Frame: Circuit Breaker States -->
        <mxCell id="alt_cb" value="alt [Opossum Circuit Breaker &amp; Exponential Backoff Retry]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=330;height=30;fillColor=none;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="440" width="730" height="260" as="geometry" />
        </mxCell>

        <mxCell id="m5_healthy" value="Case 1 (Healthy): GET /api/v1/tracking/STK89F2A/events -> 200 OK" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">

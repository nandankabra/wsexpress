PORT=8010
NODE_ENV=development
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
CORS_ORIGIN=*

# Leave SMTP_HOST unset to use the JSON transport (logs the "sent" email instead of
# connecting to a real mail server) - convenient for local/demo use without credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ShipTrack <no-reply@shiptrack.local>

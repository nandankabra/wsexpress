{
  "name": "shiptrack",
  "private": true,
  "version": "1.0.0",
  "description": "ShipTrack - Logistics & Shipment Tracking Platform (Node.js/Express microservices + React)",
  "workspaces": [
    "common",
    "services/*",
    "frontend"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "start:backend": "node scripts/start-all.js",
    "test:flows": "node scripts/check-flows.js",
    "keepalive": "node scripts/keep-render-alive.js",
    "dev": "npm run dev --workspace=frontend"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "pdfkit": "^0.20.2"
  }
}
